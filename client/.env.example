# ─── Passion Maths Study (PMS) — client configuration ─────────────────────────
# Copy to client/.env and fill in. Do NOT put backend secrets here — they are only for server/.env.

# MUST match server ADMIN_PATH exactly at build time. Do NOT use /admin.
VITE_ADMIN_PATH=/pms-control-room

# Backend URL used by the Vite dev proxy only (not used in production build).
# This is where the Express API is running locally.
VITE_DEV_API_TARGET=http://127.0.0.1:5000

# Optional: override the API base URL in production. Leave unset to use same-origin (/api).
# VITE_API_URL=https://your-domain/api
