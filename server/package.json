    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.0",
    "morgan": "^1.12.1",
    "multer": "^2.3.0",
    "node-cron": "^4.6.0",
    "otplib": "^13.5.0",
