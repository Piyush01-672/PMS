# ─── Passion Maths Study (PMS) — server configuration ───────────────────────────
# Copy to server/.env and fill in. Never commit the real .env file.

NODE_ENV=development
PORT=5000
HOST=0.0.0.0
# Number of reverse proxies in front of the app (Cloudflare / Nginx = 1)
TRUST_PROXY=1

MONGODB_URI=mongodb://127.0.0.1:27017/pms

# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
CSRF_SECRET=
ENCRYPTION_KEY=

# Public website URL (used for canonical URLs, sitemap, Open Graph)
PUBLIC_SITE_URL=http://localhost:5173
# Allowed browser origins (comma separated)
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Built React app served by Express in production
# CLIENT_DIST_DIR=../client/dist

# Private admin URL path — keep in sync with client VITE_ADMIN_PATH. Do not use /admin.
ADMIN_PATH=/pms-control-room

# Admin security
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# true = every admin must enrol an authenticator app before using the dashboard
REQUIRE_2FA=false

# Media storage: auto (Cloudinary when configured, else local disk) | local | cloudinary
STORAGE_PROVIDER=auto
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=pms
MAX_UPLOAD_MB=8
# UPLOAD_DIR=./uploads

# Automated backups (daily at 02:30 IST by default)
BACKUP_ENABLED=true
BACKUP_CRON=30 2 * * *
BACKUP_TIMEZONE=Asia/Kolkata
BACKUP_RETENTION_DAYS=30
# BACKUP_DIR=./backups
# Second, separate location for every backup (mounted drive, Google Drive for desktop folder, NAS…)
BACKUP_EXTERNAL_DIR=
# Also upload backups privately to Cloudinary (raw, authenticated)
BACKUP_CLOUDINARY=false
# Mirror locally stored uploads into BACKUP_EXTERNAL_DIR/uploads
BACKUP_INCLUDE_UPLOADS=true

# First owner account used by `npm run seed` / `npm run create-admin`
SEED_ADMIN_NAME=PMS Owner
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
